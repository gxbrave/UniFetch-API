# Required: replace this with your own random password (at least 24 characters).
API_TOKEN=replace-with-your-own-random-token-at-least-24-characters

# Outside port. Empty = 8099. Inside the container. Empty = 8000.
PORT=
CONTAINER_PORT=
# Empty = 0.0.0.0 (all host network interfaces).
HOST_BIND=

# Optional platform login cookies. Empty = use no cookie.
# Use single quotes around cookies if they contain $ or # characters.
DOUYIN_COOKIE=
XIAOHONGSHU_COOKIE=
BILIBILI_COOKIE=
# For an X account session, include both auth_token and ct0.
X_COOKIE=

# Optional: empty = build public URLs from each request and proxy headers.
PUBLIC_BASE_URL=
# Empty = true. Use false if you do not trust incoming proxy headers.
TRUST_PROXY_HEADERS=
# Empty = keep files for 24 hours, with at most 10 pending jobs.
RETENTION_HOURS=
MAX_PENDING_JOBS=
